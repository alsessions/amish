{# _partials/_footer.twig #}
<footer class="bg-gray-900 text-gray-100 py-12 mt-20">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 xl:grid-cols-2 gap-10">
      <div>
        <h3 class="text-xl font-bold mb-4 text-white border-b border-gray-700 pb-2">Jeff's Handcrafted Amish Furniture</h3>
        <p class="mb-4 text-gray-300">Custom handcrafted furniture made with quality hardwoods and expert craftsmanship.</p>
        <p class="text-gray-300">Call: <a href="tel:3158581010" class="text-white hover:text-amber-300 transition duration-300">315-858-1010</a></p>
      </div>

      <div>
        <h3 class="text-xl font-bold mb-4 text-white border-b border-gray-700 pb-2">Visit Us</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <p class="text-gray-300">276 Jordanville Road</p>
            <p class="text-gray-300 mb-4">Jordanville, NY 13361</p>
            <div class="mt-4">
              <p class="font-bold text-white mb-2">Open Hours:</p>
              <p class="text-gray-300">Monday-Friday: 8am-5pm</p>
              <p class="text-gray-300">Saturday: 9am-3pm</p>
              <p class="text-gray-300">Sunday: Closed</p>
            </div>
          </div>
          <div class="flex items-center justify-start md:justify-center">
            <div class="w-full max-w-[190px] h-[190px] border-2 border-gray-700 rounded-sm overflow-hidden">
              <iframe
                width="190"
                height="190"
                style="border:0;width:100%;height:100%;"
                loading="lazy"
                allowfullscreen
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d46777.771742475955!2d-74.92!3d42.91!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89d979b1f7955555%3A0x5a45d9951a689c74!2s276%20Jordanville%20Rd%2C%20Jordanville%2C%20NY%2013361!5e0!3m2!1sen!2sus!4v1628564786754!5m2!1sen!2sus">
              </iframe>
            </div>
          </div>
        </div>
      </div>

      <div>
        <h3 class="text-xl font-bold mb-4 text-white border-b border-gray-700 pb-2">Quick Links</h3>
        <ul>
          <li class="mb-2"><a href="/" class="text-gray-300 hover:text-amber-300 transition duration-300">Home</a></li>
          <li class="mb-2"><a href="#" class="text-gray-300 hover:text-amber-300 transition duration-300">Furniture</a></li>
          <li class="mb-2"><a href="/services" class="text-gray-300 hover:text-amber-300 transition duration-300">About Us</a></li>
          <li class="mb-2"><a href="/contact" class="text-gray-300 hover:text-amber-300 transition duration-300">Contact &amp; Directions</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-gray-700 text-center">
      <p class="text-gray-400">&copy; 2025 Jeff's Handcrafted Amish Furniture. All rights reserved.</p>
      {% if currentUser %}
        <p class="mt-2">
          {% if entry is defined and entry %}
            <a href="{{ entry.cpEditUrl }}" class="text-gray-500 hover:text-amber-300 text-sm transition duration-300">Edit Entry</a>
          {% endif %}
        </p>
      {% endif %}
    </div>
  </div>
</footer>
