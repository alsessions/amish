{% include '_partials/_head.twig' %}

<body class="ltr bg-amber-50/50">

<!-- Hero Section -->
<section class="w-full relative h-80 md:h-96 lg:h-[32rem] overflow-hidden mb-8">
    <img src="/assets/images/amish_wood.jpg" alt="Old Amish Barn" class="w-full h-full object-cover object-center" loading="eager" />
    <!-- Navbar inside hero, full width, overlayed and fully transparent -->
    {% include '_partials/_nav.twig' %}
    <div class="absolute inset-0 bg-black/30 flex items-center justify-center">
        <h1 class="text-white text-4xl md:text-5xl lg:text-6xl font-bold drop-shadow-lg text-center">Contact Us</h1>
    </div>
</section>

<section class="max-w-7xl mx-auto px-4 mb-16 min-h-screen">
    <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">{{ entry.title }}</h2>
        <div class="prose prose-lg max-w-none mb-8">{{ entry.body }}</div>
        <div>
            {{ craft.freeform.form("contact").render() }}
        </div>
    </div>
</section>

{# Use partial for footer #}
{% include '_partials/_footer.twig' %}

</body>
</html>
