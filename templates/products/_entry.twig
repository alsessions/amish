{% extends '_layouts/base.twig' %}

{% block hero %}
{% set heroAsset = entry.featuredImage.one() %}
<section class="w-full relative h-96 md:h-[28rem] lg:h-[38rem] overflow-hidden mb-8">
    {% if heroAsset %}
        <img src="{{ heroAsset.url }}" alt="{{ entry.title }}" class="w-full h-full object-cover object-center" loading="eager" />
    {% else %}
        <img src="/assets/images/amish_wood.jpg" alt="Old Amish Barn" class="w-full h-full object-cover object-center" loading="eager" />
    {% endif %}
    {% include '_partials/_nav.twig' %}
    <div class="absolute inset-0 bg-black/30 flex items-center justify-center flex-col text-center px-4">
        <h1 class="text-white text-4xl md:text-5xl lg:text-6xl font-bold drop-shadow-lg">{{ entry.title }}</h1>
        {% if entry.summary is defined and entry.summary %}

          <p class="mt-5 max-w-2xl mx-auto text-xl md:text-2xl lg:text-2xl text-white font-semibold drop-shadow-lg bg-black/20 rounded px-4 py-3">{{ entry.summary|striptags|truncate(200) }}</p>

        {% endif %}
    </div>
</section>
{% endblock %}

{% block content %}
<section class="max-w-7xl mx-auto px-4 mb-16 min-h-screen">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3  gap-8">
    {% set products = entry.getChildren().all() %}
    {% for product in products %}
      <div class="bg-white rounded-lg shadow hover:shadow-lg transition overflow-hidden flex flex-col">
        {% set asset = product.featuredImage.one() %}
        <div class="w-full overflow-hidden">
        {% if asset and attribute(asset, 'optimizedCard') is defined and asset.optimizedCard %}

          {{ asset.optimizedCard.imgTag().render({
            alt: product.title,
            class: 'w-full h-48 object-cover object-center',
            loading: 'lazy'
          }) }}

        {% elseif asset %}

          <img src="{{ asset.url }}" alt="{{ product.title }}" class="w-full h-48 object-cover object-center" loading="lazy" />

        {% else %}

          <div class="w-full h-48 bg-amber-100 flex items-center justify-center text-amber-400 text-4xl">
            <span>No Image</span>
          </div>

        {% endif %}
        </div>
        <div class="p-4 flex-1 flex flex-col">
          <h2 class="text-xl font-semibold mb-2">{{ product.title }}</h2>
          {% if product.summary is defined and product.summary %}

            <p class="text-gray-700 mb-4">{{ product.summary|striptags|truncate(100) }}</p>

          {% endif %}
          <a href="{{ product.url }}" class="mt-auto inline-block text-amber-700 hover:text-amber-900 font-medium">View Details &rarr;</a>
        </div>
      </div>
    {% else %}
      <div class="col-span-full text-center text-gray-500 py-12">
        <p>No products found.</p>
      </div>
    {% endfor %}
  </div>
</section>
{% endblock %}
