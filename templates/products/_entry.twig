{% extends '_layouts/base.twig' %}

{% block hero %}
{% set heroAsset = entry.featuredImage.one() %}
<section class="w-full relative h-96 md:h-[28rem] lg:h-[38rem] overflow-visible mb-8">
    {% if heroAsset %}
        {% if attribute(heroAsset, 'optimizedHero') is defined and heroAsset.optimizedHero %}
            {% set optimizedHero = heroAsset.optimizedHero %}
            {% set webpSrcset = optimizedHero.srcsetWebp() %}
            <picture class="block w-full h-full">
                {% if webpSrcset %}
                    <source
                        srcset="{{ webpSrcset }}"
                        sizes="100vw"
                        type="image/webp"
                    />
                {% endif %}
                <img
                    srcset="{{ optimizedHero.srcset() }}"
                    sizes="100vw"
                    src="{{ optimizedHero.src() }}"
                    alt="{{ entry.title }}"
                    class="w-full h-full object-cover object-center"
                    loading="eager"
                />
            </picture>
        {% else %}
            <img src="{{ heroAsset.url }}" alt="{{ entry.title }}" class="w-full h-full object-cover object-center" loading="eager" />
        {% endif %}
    {% else %}
        <img src="/assets/images/amish_wood.jpg" alt="Old Amish Barn" class="w-full h-full object-cover object-center" loading="eager" />
    {% endif %}
    {% include '_partials/_nav.twig' %}
    <div class="absolute inset-0 bg-black/30 flex items-center justify-center flex-col text-center px-4">
        <h1 class="text-white text-4xl md:text-5xl lg:text-6xl font-bold drop-shadow-lg">{{ entry.title }}</h1>
        {% if entry.summary is defined and entry.summary %}

          <p class="mt-5 max-w-2xl mx-auto text-xl md:text-2xl lg:text-2xl text-white font-semibold drop-shadow-lg bg-black/20 rounded px-4 py-3">{{ entry.summary|striptags|truncate(200) }}</p>

        {% endif %}
    </div>
</section>
{% endblock %}

{% block content %}
<section class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8 mb-16 min-h-screen">
  {% set catalogLink = entry.catalogLink ?? null %}
  {% set catalogLink2 = entry.catalogLink2 ?? null %}
  <div class="mb-10 flex flex-wrap justify-center gap-4">
    {% if (catalogLink and catalogLink.url) or (catalogLink2 and catalogLink2.url) %}
      {% if catalogLink and catalogLink.url %}
        <a href="{{ catalogLink.url }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 bg-red-600 hover:bg-red-700 text-white font-semibold px-6 py-3 rounded-lg shadow-lg transition-colors duration-200">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8l-6-6z"/><path d="M14 2v6h6"/><path fill="#fff" d="M10 15.5v-3h1v3h-1zm2 0v-3h1v3h-1z"/></svg>
          <span>Download Catalog</span>
        </a>
      {% endif %}
      {% if catalogLink2 and catalogLink2.url %}
        <a href="{{ catalogLink2.url }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 bg-red-600 hover:bg-red-700 text-white font-semibold px-6 py-3 rounded-lg shadow-lg transition-colors duration-200">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8l-6-6z"/><path d="M14 2v6h6"/><path fill="#fff" d="M10 15.5v-3h1v3h-1zm2 0v-3h1v3h-1z"/></svg>
          <span>Download Catalog 2</span>
        </a>
      {% endif %}
    {% else %}
      <span class="inline-flex items-center gap-3 bg-gray-400 text-gray-200 font-semibold px-6 py-3 rounded-lg shadow-lg cursor-not-allowed">
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8l-6-6z"/><path d="M14 2v6h6"/></svg>
        <span>Download Catalog</span>
      </span>
    {% endif %}
  </div>
  {% include '_partials/_ordering.twig' %}

  {% if entry.pageBuilder is defined and entry.pageBuilder|length %}
    {% for block in entry.pageBuilder.all() %}
      {# Text-only block #}
      {% if block.body is defined and block.body %}
        <div class="prose prose-lg leading-relaxed max-w-none mx-auto mb-10">
          {{ block.body|nl2br }}
        </div>
      {% endif %}

      {# Image block with imageBlock matrix #}
      {# Debug: {{ block.type.handle }} #}
      {% if block.type.handle == 'imageBlock' %}
        {% set images = block.image.all() %}
      {% else %}
        {% set images = [] %}
      {% endif %}
      {% if images|length %}
        <div class="my-10">
          {% if images|length == 1 %}
            <img srcset="{{ images[0].optimizedCard.srcset() }}" src="{{ images[0].optimizedCard.src() }}" alt="{{ images[0].title ?? entry.title }}" class="w-full h-auto rounded-xl shadow-lg" loading="lazy" />
          {% elseif images|length == 2 %}
            <div class="grid grid-cols-2 gap-4">
              <img srcset="{{ images[0].optimizedCard.srcset() }}" src="{{ images[0].optimizedCard.src() }}" alt="{{ images[0].title ?? entry.title }}" class="w-full h-auto rounded-xl shadow-lg" loading="lazy" />
              <img srcset="{{ images[1].optimizedCard.srcset() }}" src="{{ images[1].optimizedCard.src() }}" alt="{{ images[1].title ?? entry.title }}" class="w-full h-auto rounded-xl shadow-lg" loading="lazy" />
            </div>
          {% elseif images|length == 3 %}
            <div class="flex gap-4">
              <div class="w-1/2">
                <img srcset="{{ images[0].optimizedCard.srcset() }}" src="{{ images[0].optimizedCard.src() }}" alt="{{ images[0].title ?? entry.title }}" class="w-full h-full object-cover rounded-xl shadow-lg" loading="lazy" />
              </div>
              <div class="w-1/2 flex flex-col gap-4">
                <img srcset="{{ images[1].optimizedCard.srcset() }}" src="{{ images[1].optimizedCard.src() }}" alt="{{ images[1].title ?? entry.title }}" class="w-full h-auto rounded-xl shadow-lg" loading="lazy" />
                <img srcset="{{ images[2].optimizedCard.srcset() }}" src="{{ images[2].optimizedCard.src() }}" alt="{{ images[2].title ?? entry.title }}" class="w-full h-auto rounded-xl shadow-lg" loading="lazy" />
              </div>
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  {% endif %}
</section>
{% endblock %}
