{% extends '_layouts/base.twig' %}

{% block hero %}
<section class="w-full relative h-80 md:h-96 lg:h-[32rem] overflow-hidden mb-8">
    <img src="/assets/images/amish_wood.jpg" alt="Old Amish Barn" class="w-full h-full object-cover object-center" loading="eager" />
    {% include '_partials/_nav.twig' %}
    <div class="absolute inset-0 bg-black/30 flex items-center justify-center">
        <h1 class="text-white text-4xl md:text-5xl lg:text-6xl font-bold drop-shadow-lg text-center">Jeffs Amish Furniture</h1>
    </div>
</section>
{% endblock %}

{% block content %}
<section class="max-w-7xl mx-auto px-4 mb-16 min-h-screen">

    <!-- Call to Action Section -->
    <div class="text-center mb-20 py-12">
        <div class="max-w-5xl mx-auto">
            <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-8">Handcrafted Quality, Built to Last</h2>
            <p class="text-xl text-gray-700 mb-12 leading-relaxed max-w-3xl mx-auto">
                Discover our collection of authentic Amish furniture, meticulously crafted by skilled artisans using time-honored techniques and premium hardwoods. Each piece is built with exceptional attention to detail, ensuring furniture that will be treasured for generations.
            </p>
            <div class="flex flex-col sm:flex-row gap-6 justify-center">
                <a href="/products" class="inline-block bg-amber-700 hover:bg-amber-800 text-white font-semibold px-10 py-4 rounded-lg transition shadow-lg hover:shadow-xl text-lg">
                    Browse Our Collection
                </a>
                <a href="/contact" class="inline-block border-2 border-amber-700 text-amber-700 hover:bg-amber-700 hover:text-white font-semibold px-10 py-4 rounded-lg transition text-lg">
                    Get Custom Quote
                </a>
            </div>
        </div>
    </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
    {% set products = craft.entries.section('products').level(1).all() %}
    {% for product in products %}
      <div class="bg-white rounded shadow-sm hover:shadow-md transition overflow-hidden flex flex-col">
        {% set asset = product.featuredImage.one() %}
        <div class="w-full overflow-hidden border-b">
        {% if asset and attribute(asset, 'optimizedCard') is defined and asset.optimizedCard %}

          {{ asset.optimizedCard.imgTag().render({
            alt: product.title,
            class: 'w-full h-full object-cover object-center',
            loading: 'lazy'
          }) }}

        {% elseif asset %}

          <img src="{{ asset.url }}" alt="{{ product.title }}" class="w-full h-full object-cover object-center" loading="lazy" />

        {% else %}

          <div class="w-full h-full flex items-center justify-center text-amber-400 text-4xl">
            <span>No Image</span>
          </div>

        {% endif %}
        </div>

        <div class="p-3 flex-1 flex flex-col">
          <h2 class="text-lg font-semibold mb-1">{{ product.title }}</h2>
          {% if product.summary is defined and product.summary %}

            <p class="text-gray-600 text-sm mb-3">{{ product.summary|striptags|truncate(80) }}</p>

          {% endif %}
          <a href="{{ product.url }}" class="mt-auto inline-block text-amber-700 hover:text-amber-900 font-medium text-sm">View Details &rarr;</a>
        </div>
      </div>
    {% else %}
      <div class="col-span-full text-center text-gray-500 py-12">
        <p>No products found.</p>
      </div>
    {% endfor %}
  </div>
</section>
{% endblock %}
